# Shorebird 配置模板
#
# 说明：把本文件复制为 shorebird.yaml，并填入 `shorebird init` 生成的 app_id。
#       shorebird.yaml 需要提交到仓库；app_id 不是密钥，可公开。
#
# 生成方式：
#   1) shorebird login
#   2) 项目根目录执行 shorebird init
#
# 支持的字段（按需启用）：
#   app_id: <你的 app id>            # 必填
#   flavors:                          # 多渠道时使用
#     dev:
#       app_id: <dev 渠道 id>
#     prod:
#       app_id: <prod 渠道 id>
#   auto_update: true                 # 默认 true：启动后自动检查补丁
#   base_url: https://download.shorebird.dev   # 私有化/自建时改这里
